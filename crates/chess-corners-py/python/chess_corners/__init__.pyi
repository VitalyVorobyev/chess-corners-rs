# ---------------------------------------------------------------------------
# Detections
# ---------------------------------------------------------------------------

class Detections:
    """Detected chessboard corners with per-corner response and optional orientation."""

    @property
    def xy(self) -> np.ndarray:
        """``(N, 2)`` float32 array of corner coordinates ``(x, y)`` in image pixels."""
        ...

    @property
    def response(self) -> np.ndarray:
        """``(N,)`` float32 array of per-corner response values."""
        ...

    @property
    def angles(self) -> np.ndarray | None:
        """``(N, 2)`` float32 array of axis angles (radians), or ``None`` when
        orientation estimation was disabled."""
        ...

    @property
    def sigmas(self) -> np.ndarray | None:
        """``(N, 2)`` float32 array of per-axis fit-quality scores in radians
        (larger means a less reliable axis; not a calibrated 1σ, and
        independent of the noise level and ``Uncertainty``), or ``None`` when
        orientation estimation was disabled. Use it for ranking and gating."""
        ...

    @property
    def position_covariance(self) -> np.ndarray:
        """``(N, 2, 2)`` float32 array of per-corner position covariance in px²
        (``[[xx, xy], [xy, yy]]``). Rows are ``NaN`` for corners without one:
        every localizer except the ML refiner reports it under
        ``Uncertainty.PROPAGATED``; none does under ``Uncertainty.OFF`` (the
        default) or on upscaled input. The covariance includes a per-localizer floor measured
        on real images that usually dominates it there; weighting by it has
        not been shown to beat uniform weighting on real data."""
        ...

    def __len__(self) -> int: ...
    def __repr__(self) -> str: ...

# ---------------------------------------------------------------------------
# Detector
# ---------------------------------------------------------------------------

class Detector:
    def __init__(self, cfg: DetectorConfig | None = ...) -> None: ...
    def detect(self, image: np.ndarray) -> Detections: ...
    def config(self) -> DetectorConfig: ...
    def apply_config(self, cfg: DetectorConfig | None) -> None: ...
    def chess_response(self, image: np.ndarray) -> np.ndarray:
        """Return the intermediate dense ChESS response map.

        Opt-in diagnostic evidence for debugging and visualization —
        the per-pixel ChESS response computed internally — not part of
        the normal detection result returned by :meth:`detect`.
        """
        ...
    def radon_heatmap(self, image: np.ndarray) -> np.ndarray:
        """Return the intermediate dense Radon-response heatmap.

        Opt-in diagnostic evidence for debugging and visualization —
        the per-pixel Radon response computed internally — not part of
        the normal detection result returned by :meth:`detect`.
        """
        ...

def estimate_noise_sigma(image: np.ndarray) -> Optional[float]:
    """Standard deviation of the pixel noise of a ``(H, W)`` ``uint8`` image,
    in gray levels: the per-image estimate the detector uses for position
    covariances when ``DetectorConfig.noise_sigma`` is ``None``. ``None`` when
    the image is smaller than 4×4 or has too few structure-free areas."""
    ...

__all__: list[str]
