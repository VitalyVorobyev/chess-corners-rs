"""Type stubs for the chess_corners public surface.

These stubs mirror the runtime classes exposed by the compiled
``_native`` extension. Every public surface class lists its
attributes, classmethod factories, and serialization helpers so IDEs
and type checkers can offer accurate autocompletion.
"""

from __future__ import annotations

