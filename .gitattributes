# Normalise line endings so generated artefacts (schemas/) compare byte-for-byte.
# Keep this first: later rules (LFS `-text`) must override it.
* text=auto eol=lf

testimages/ filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.bmp filter=lfs diff=lfs merge=lfs -text
book/src/img/*.png filter=lfs diff=lfs merge=lfs -text
